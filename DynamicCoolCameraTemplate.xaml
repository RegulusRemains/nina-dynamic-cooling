<ResourceDictionary
    x:Class="NINA.Plugin.DynamicCooling.DynamicCoolCameraTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:local="clr-namespace:NINA.Plugin.DynamicCooling">

    <!-- Dynamic Cool Camera -->
    <DataTemplate DataType="{x:Type local:DynamicCoolCameraInstruction}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Vertical" Margin="5,0">
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" FontSize="11"
                               ToolTip="Configured in Plugins ▸ Dynamic Cooling"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Cooling time:" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="11"/>
                        <Grid Width="45">
                            <TextBox Text="{Binding CoolingDurationMinutesText, UpdateSourceTrigger=PropertyChanged}" FontSize="11"
                                     ToolTip="Leave empty to use the cooling timeout from Plugins ▸ Dynamic Cooling"/>
                            <TextBlock Text="{Binding DefaultCoolingDurationText}" Foreground="{StaticResource PrimaryBrush}" Opacity="0.45"
                                       Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoolingDurationMinutes}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="min" Foreground="{StaticResource PrimaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
</ResourceDictionary>
