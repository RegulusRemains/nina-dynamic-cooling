<ResourceDictionary
    x:Class="NINA.Plugin.DynamicCooling.DynamicCoolCameraTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:local="clr-namespace:NINA.Plugin.DynamicCooling">

    <!-- Dynamic Cool Camera -->
    <DataTemplate DataType="{x:Type local:DynamicCoolCameraInstruction}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Vertical" Margin="5,0">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Source:" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding TemperatureSource}" MinWidth="240" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Max delta:" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Text="{Binding MaxDelta}" Width="45" FontSize="11"/>
                        <TextBlock Text="°C  Min target:" Foreground="{StaticResource PrimaryBrush}" Margin="5,0,5,0" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Text="{Binding MinimumTarget}" Width="45" FontSize="11"/>
                        <TextBlock Text="°C  Fallback:" Foreground="{StaticResource PrimaryBrush}" Margin="5,0,5,0" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Text="{Binding FallbackTarget}" Width="45" FontSize="11"/>
                        <TextBlock Text="°C" Foreground="{StaticResource SecondaryBrush}" Margin="2,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Cooling timeout:" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Text="{Binding CoolingDurationMinutes}" Width="40" FontSize="11"/>
                        <TextBlock Text="min" Foreground="{StaticResource SecondaryBrush}" Margin="2,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                        <CheckBox Content="Only step colder on re-check" IsChecked="{Binding OnlyColder}" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
</ResourceDictionary>
