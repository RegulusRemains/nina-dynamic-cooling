<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>NINA.Plugin.DynamicCooling</RootNamespace>
    <AssemblyName>NINA.Plugin.DynamicCooling</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Page Include="DynamicCoolCameraTemplate.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="DynamicCoolCameraTemplate.xaml.cs">
      <DependentUpon>DynamicCoolCameraTemplate.xaml</DependentUpon>
    </Compile>
    <Page Include="DynamicCoolingOptionsTemplate.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="DynamicCoolingOptionsTemplate.xaml.cs">
      <DependentUpon>DynamicCoolingOptionsTemplate.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" />
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests has its own project; keep its sources out of the plugin assembly -->
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>
</Project>
