<ResourceDictionary
    x:Class="NINA.Plugin.DynamicCooling.DewHeaterTriggerTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:local="clr-namespace:NINA.Plugin.DynamicCooling">

    <!-- Dew Heater Control trigger -->
    <DataTemplate DataType="{x:Type local:DewHeaterTrigger}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" FontSize="11"
                               ToolTip="Configured in Plugins ▸ Dynamic Cooling"/>
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
</ResourceDictionary>
